    {
      "id": "msg:1",
      "type": "Positioning",
      "label": "The community layer of the agentic era",
      "source": "https://centralsquare.ai/"
    },
    {
      "id": "msg:2",
      "type": "Mission",
      "label": "Agents will do more and more of the work. People trusting each other is the part they can't do, and that trust lives in communities.",
      "source": "https://centralsquare.ai/"
    },
    {
      "id": "msg:3",
      "type": "Problem",
      "label": "Most community teams are one or two people doing the work of seven.",
      "source": "https://centralsquare.ai/"
